<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Create account | ExpenseFlow</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head>
<body class="auth-page"><div class="auth-layout"><section class="auth-visual"><div class="auth-brand">₹ &nbsp; ExpenseFlow</div><div><div class="eyebrow" style="color:#b9b0ff">START WITH CLARITY</div><h2>Build better habits with your money.</h2><p>Get a clear view of what comes in, what goes out and what you have left.</p><div class="auth-feature"><strong>✦ Simple. Organized. Yours.</strong><small>One dashboard for your everyday financial records.</small></div></div><small style="color:#aeb4d5">PERSONAL EXPENSE TRACKER</small></section>
<section class="auth-card"><div class="eyebrow">GET STARTED</div><h1>Create your account</h1><p class="muted">It only takes a moment to set up your personal tracker.</p><c:if test="${not empty error}"><p class="error"><c:out value="${error}"/></p></c:if>
<form method="post" action="${pageContext.request.contextPath}/register"><label>Full name</label><input type="text" name="name" maxlength="100" placeholder="Your name" required><label>Email address</label><input type="email" name="email" maxlength="150" placeholder="you@example.com" required><label>Password <span class="muted">(minimum 6 characters)</span></label><input type="password" name="password" minlength="6" placeholder="Create a password" required><button class="button" type="submit">Create account →</button></form><div class="auth-footer">Already have an account? <a href="${pageContext.request.contextPath}/login">Sign in</a></div></section></div></body></html>