<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Login | ExpenseFlow</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head>
<body class="auth-page"><div class="auth-layout"><section class="auth-visual"><div class="auth-brand">₹ &nbsp; ExpenseFlow</div><div><div class="eyebrow" style="color:#b9b0ff">SMARTER MONEY HABITS</div><h2>Make every rupee count.</h2><p>A simple place to understand your spending, track your income and stay in control of your finances.</p><div class="auth-feature"><strong>✦ Your money, made clearer</strong><small>Track expenses and income in one organized dashboard.</small></div></div><small style="color:#aeb4d5">PERSONAL EXPENSE TRACKER</small></section>
<section class="auth-card"><div class="eyebrow">WELCOME BACK</div><h1>Sign in to your account</h1><p class="muted">Enter your details to continue to your dashboard.</p>
<c:if test="${not empty message}"><p class="success"><c:out value="${message}"/></p></c:if><c:if test="${not empty error}"><p class="error"><c:out value="${error}"/></p></c:if>
<form method="post" action="${pageContext.request.contextPath}/login"><label>Email address</label><input type="email" name="email" placeholder="you@example.com" required><label>Password</label><input type="password" name="password" placeholder="Enter your password" required><button class="button" type="submit">Sign in →</button></form><div class="auth-footer">New to ExpenseFlow? <a href="${pageContext.request.contextPath}/register">Create an account</a></div></section></div></body></html>